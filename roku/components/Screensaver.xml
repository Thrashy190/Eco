<?xml version="1.0" encoding="utf-8"?>
<!--
  Eco's screensaver (source/screensaver.brs): the cover of what plays over its own colour, moving every so often so
  nothing burns into the screen. It runs apart from the app, so it reads what plays from the registry.
-->
<component name="Screensaver" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/Screensaver.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0B0FFF" />
    <Poster id="wash" width="1920" height="1080" loadDisplayMode="scaleToFill" opacity="0.7" />
    <Poster uri="pkg:/images/veil.png" width="1920" height="1080" loadDisplayMode="scaleToFill" />
    <Group id="card">
      <Poster id="cover" width="440" height="440" loadDisplayMode="scaleToZoom" failedBitmapUri="pkg:/images/logo.png" />
      <Label id="title" translation="[0,470]" width="700" color="0xF4F4F7FF">
        <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="44" />
      </Label>
      <Label id="artist" translation="[0,530]" width="700" color="0x9B9BA8FF">
        <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="32" />
      </Label>
    </Group>
    <Timer id="check" duration="5" repeat="true" />
    <Timer id="drift" duration="20" repeat="true" />
    <Animation id="move" duration="3" easeFunction="inOutCubic">
      <Vector2DFieldInterpolator id="path" key="[0, 1]" fieldToInterp="card.translation" />
    </Animation>
  </children>
</component>
