<?xml version="1.0" encoding="utf-8"?>
<!--
  A row in a list of songs (and of search results). The content node carries title, description (the line under it),
  HDPosterUrl (empty to show shortDescriptionLine2, the track number, instead), shortDescriptionLine1 (the length) and
  id (the song, which lights up while it plays).
-->
<component name="SongItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="listHasFocus" type="boolean" onChange="paint" />
    <field id="gridHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/SongItem.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/round-small.9.png" blendColor="0xFFFFFF00" />
    <Poster id="mask" uri="pkg:/images/mask-soft.png" width="60" height="60" translation="[14,12]" blendColor="0x2A2A33FF" />
    <Poster id="cover" width="60" height="60" translation="[14,12]" loadDisplayMode="scaleToZoom" />
    <Poster id="playing" uri="pkg:/images/icons/play.png" width="26" height="26" visible="false" />
    <Label id="number" width="60" height="84" translation="[14,0]" horizAlign="center" vertAlign="center" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="26" />
    </Label>
    <Label id="title" translation="[96,12]" color="0xF4F4F7FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="29" />
    </Label>
    <Label id="subtitle" translation="[96,48]" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="23" />
    </Label>
    <Label id="length" horizAlign="right" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="25" />
    </Label>
  </children>
</component>
