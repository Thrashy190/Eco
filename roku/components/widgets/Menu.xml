<?xml version="1.0" encoding="utf-8"?>
<!-- Options over the screen (the ✱ key on a song, leaving the app…). Back closes it. -->
<component name="Menu" extends="Group">
  <interface>
    <field id="title" type="string" />
    <field id="options" type="array" />
    <!-- Set to true to open it; it takes the focus -->
    <field id="show" type="boolean" alwaysNotify="true" onChange="open" />
    <field id="chosen" type="integer" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/Menu.brs" />
  <children>
    <Group id="box" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000A6" />
      <Poster id="panel" uri="pkg:/images/round.9.png" width="760" blendColor="0x1D1D26FF" translation="[580,0]" />
      <Label id="heading" width="680" translation="[620,0]" color="0xF4F4F7FF" wrap="true" maxLines="2">
        <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="34" />
      </Label>
      <LabelList id="list" translation="[620,0]" itemSize="[680,72]" itemSpacing="[0,6]" color="0xF4F4F7FF" focusedColor="0x05241AFF" focusBitmapUri="pkg:/images/focus.9.png" focusBitmapBlendColor="0x7CF0C0FF" textHorizAlign="left" vertFocusAnimationStyle="floatingFocus">
        <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="30" />
        <Font role="focusedFont" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="30" />
      </LabelList>
    </Group>
  </children>
</component>
