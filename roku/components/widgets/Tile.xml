<?xml version="1.0" encoding="utf-8"?>
<!--
  A card in a row or a grid: a rounded cover (round for artists) with a title and a line under it, like the web app's
  cards. The focused card gets a ring in the accent. The content node carries title, description,
  `art` (see artUrl in lib/api.brs), `kind` and `ref` (lib/ui.brs) and, for artists, shape "circle".
-->
<component name="Tile" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="show" />
    <field id="width" type="float" onChange="layout" />
    <field id="height" type="float" onChange="layout" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="rowHasFocus" type="boolean" onChange="paint" />
    <field id="rowListHasFocus" type="boolean" onChange="paint" />
    <field id="gridHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/api.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/Tile.brs" />
  <children>
    <Group id="art">
      <!-- The shape, empty until the cover arrives (and what Favorites is drawn on) -->
      <Poster id="back" uri="pkg:/images/mask-soft.png" blendColor="0x1D1D26FF" />
      <Poster id="heart" uri="pkg:/images/favorites-heart.png" visible="false" />
      <Poster id="cover" loadDisplayMode="scaleToZoom" />
      <Poster id="ring" uri="pkg:/images/ring-soft.png" visible="false" />
    </Group>
    <Label id="title" color="0xF4F4F7FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="27" />
    </Label>
    <Label id="subtitle" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="23" />
    </Label>
  </children>
</component>
