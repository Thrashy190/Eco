<?xml version="1.0" encoding="utf-8"?>
<!--
  A row of pills: the tabs in the top bar, buttons (Play, Shuffle) and the player's controls. Left and right move,
  OK chooses; at either end the key goes on to the screen. The focused one takes the accent (dynamic with the cover,
  like the web app); the chosen tab is white, as in the web app's top bar. With `display` on, the screen moves the
  focus itself (focusIndex, lit) and this only draws.
-->
<component name="Tabs" extends="Group">
  <interface>
    <!-- [{label, icon, on, primary}]: icon is a name in images/icons; `on` lights an option that is switched on;
         `primary` is the main action (Play), always in the accent -->
    <field id="items" type="array" onChange="build" />
    <!-- "tabs", "buttons" or "icons" (round, icon only) -->
    <field id="look" type="string" value="tabs" onChange="build" />
    <field id="selected" type="integer" value="-1" onChange="paint" />
    <field id="focusIndex" type="integer" value="0" onChange="paint" />
    <field id="chosen" type="integer" alwaysNotify="true" />
    <field id="width" type="float" />
    <field id="lit" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/widgets/Tabs.brs" />
  <children>
    <Group id="row" />
  </children>
</component>
