<?xml version="1.0" encoding="utf-8"?>
<!-- Search the library: a keyboard on the left, artists, albums and songs on the right as you type. -->
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="args" type="assocarray" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="takeFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/api.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
  <children>
    <MiniKeyboard id="keyboard" translation="[96,160]" />
    <Label id="hint" text="Type an artist, an album or a song. Your library answers as you type." translation="[112,880]" width="560" wrap="true" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="26" />
    </Label>
    <Label id="status" translation="[720,180]" width="1104" wrap="true" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="32" />
    </Label>
    <MarkupList id="results" translation="[720,160]" itemComponentName="SongItem" itemSize="[1104,84]" itemSpacing="[0,6]" numRows="9" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    <Timer id="debounce" duration="0.45" />
    <Menu id="menu" />
  </children>
</component>
