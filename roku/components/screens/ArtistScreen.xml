<?xml version="1.0" encoding="utf-8"?>
<!-- An artist: their albums in a row and every song of theirs in the library under it. -->
<component name="ArtistScreen" extends="Group">
  <interface>
    <!-- {id, name}; with only a name, the library is searched for it -->
    <field id="args" type="assocarray" onChange="load" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="takeFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/api.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/ArtistScreen.brs" />
  <children>
    <Group translation="[96,160]">
      <Poster uri="pkg:/images/mask-circle.png" width="380" height="380" blendColor="0x1D1D26FF" />
      <Poster id="cover" width="380" height="380" loadDisplayMode="scaleToZoom" />
    </Group>
    <Label text="ARTIST" translation="[96,572]" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="22" />
    </Label>
    <Label id="name" translation="[96,606]" width="400" wrap="true" maxLines="3" color="0xF4F4F7FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="48" />
    </Label>
    <Label id="subtitle" width="400" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="26" />
    </Label>
    <Tabs id="actions" look="buttons" />
    <Label id="status" text="Loading..." translation="[560,180]" width="1264" wrap="true" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="32" />
    </Label>
    <RowList id="albums" translation="[536,150]" itemComponentName="Tile" numRows="1" itemSize="[1312,400]" rowItemSize="[[220,310]]" rowItemSpacing="[[28,0]]" showRowLabel="[true]" rowLabelOffset="[[24,14]]" focusXOffset="[24]" rowLabelColor="0xF4F4F7FF" rowFocusAnimationStyle="floatingFocus" drawFocusFeedback="false">
      <Font role="rowLabelFont" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="32" />
    </RowList>
    <Label id="songsLabel" text="Songs" translation="[560,580]" color="0xF4F4F7FF" visible="false">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="32" />
    </Label>
    <MarkupList id="list" translation="[560,636]" itemComponentName="SongItem" itemSize="[1264,84]" itemSpacing="[0,6]" numRows="4" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    <Menu id="menu" />
  </children>
</component>
