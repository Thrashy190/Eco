<?xml version="1.0" encoding="utf-8"?>
<!-- The library: albums, artists, playlists and imported audio, as a grid. ✱ on Albums changes the order. -->
<component name="LibraryScreen" extends="Group">
  <interface>
    <field id="args" type="assocarray" onChange="load" />
    <field id="navigate" type="assocarray" alwaysNotify="true" />
    <field id="focusIn" type="boolean" alwaysNotify="true" onChange="takeFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/lib/format.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/api.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/request.brs" />
  <script type="text/brightscript" uri="pkg:/components/lib/ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/LibraryScreen.brs" />
  <children>
    <Tabs id="sections" translation="[96,150]" />
    <Label id="count" translation="[96,150]" width="1728" height="64" horizAlign="right" vertAlign="center" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="26" />
    </Label>
    <Label id="status" translation="[96,270]" width="1728" color="0x9B9BA8FF" wrap="true">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="32" />
    </Label>
    <MarkupGrid id="grid" translation="[96,268]" itemComponentName="Tile" itemSize="[250,340]" itemSpacing="[46,36]" numColumns="6" numRows="2" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    <Menu id="menu" />
  </children>
</component>
