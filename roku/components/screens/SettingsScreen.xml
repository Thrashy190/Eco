    <LabelList id="actions" translation="[132,560]" itemSize="[640,76]" itemSpacing="[0,10]" numRows="2" color="0xF4F4F7FF" focusedColor="0x05241AFF" focusBitmapUri="pkg:/images/focus.9.png" vertFocusAnimationStyle="floatingFocus">
