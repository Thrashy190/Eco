    <Label text="The remote" translation="[1048,286]" color="0xF4F4F7FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Bold.ttf" size="34" />
    </Label>
    <Label id="keys" translation="[1048,350]" width="740" wrap="true" lineSpacing="12" color="0x9B9BA8FF">
      <Font role="font" uri="pkg:/fonts/BricolageGrotesque-Regular.ttf" size="27" />
    </Label>
  </children>
</component>
