# Eco configuration. Copy this file to .env and edit it:   cp .env.example .env
#
# Every variable is explained here and, in more detail, in docs/configuration.md.
# Lines starting with # are comments. REQUIRED means Eco cannot do its job without it.
# Never commit .env or share it: it holds secrets.

# ============================================================================
# 1. Basics
# ============================================================================

# REQUIRED (Docker). The user and group that will own your music files.
# Get yours by running `id -u` and `id -g` on the server (1000 on most single-user Linux machines).
PUID=1000
PGID=1000

# Your time zone, for log times. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Where everything is stored. Your music goes in DATA_DIR/music. A relative path is relative to this folder.
# On a server people usually use something like /srv/data.
DATA_DIR=./data

# Optional parts to start by default, comma separated (leave empty for just Navidrome + Eco):
#   tunnel     a Cloudflare tunnel to reach Eco from anywhere     (needs TUNNEL_TOKEN, section 5)
#   downloads  Lidarr + Prowlarr + qBittorrent for whole albums   (see docs/downloads-stack.md)
# COMPOSE_PROFILES=tunnel

# ============================================================================
# 2. Song information
# ============================================================================
# Eco searches MusicBrainz, takes covers from the Cover Art Archive and asks iTunes for what those cannot answer.
# Nothing to set up, no account, no cost.
# See docs/configuration.md → "Where song information comes from".
# CATALOG=musicbrainz
# MUSICBRAINZ_URL=                  # your own MusicBrainz mirror, which has no limit of one request per second
# CATALOG_BACKUP=itunes             # or none
# ITUNES_COUNTRY=us                 # which iTunes store to ask, such as mx

# Only needed for `eco likes export` (your Spotify likes and playlists), `eco get -s` and CATALOG=spotify.
# It takes a developer app owned by someone with Spotify Premium. Steps: docs/configuration.md → "Spotify".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Only used by `eco likes`, to sign you in to Spotify. It must be listed EXACTLY like this in your Spotify
# app's Redirect URIs. You normally never change it.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ============================================================================
# 3. YouTube  (recommended: YouTube blocks anonymous downloads after a while)
# ============================================================================
# If you see "Sign in to confirm you're not a bot", give yt-dlp a logged-in session. Pick ONE:
#
# a) A computer with a browser (running Eco without Docker): name the browser.
#    One of: firefox, chrome, chromium, brave, edge, opera, vivaldi, safari
YT_COOKIES_BROWSER=
#
# b) A server or Docker (no browser): a cookies.txt file. Put it at ./secrets/cookies.txt and leave the
#    path below as it is. How to create it: docs/configuration.md → "YouTube cookies".
YT_COOKIES_FILE=/secrets/cookies.txt

# ============================================================================
# 4. Network
# ============================================================================
# Which network interface each service listens on.
#   127.0.0.1  only this machine (safe default)
#   0.0.0.0    every device on your network (to try it from your phone before setting up a tunnel)
# Never expose these ports to the internet directly: use a tunnel or Tailscale (docs/deployment.md).
ECO_BIND=127.0.0.1
ECO_PORT=8000
ND_BIND=127.0.0.1

# ============================================================================
# 5. Cloudflare tunnel  (only with the "tunnel" profile)
# ============================================================================
# The token of your tunnel: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker.
# Copy only what comes after `--token`. Details: docs/deployment.md → "Option A".
TUNNEL_TOKEN=

# ============================================================================
# 6. Your Navidrome account  (used by `eco likes favorites`, and by Lidarr)
# ============================================================================
# An existing Navidrome user. `eco likes favorites` fills THIS user's favourites with your Spotify liked
# songs. Lidarr additionally needs it to be an ADMIN, to ask Navidrome to rescan after an import.
# Use the real password. It stays in this file; it is never sent anywhere but to your own Navidrome.
ND_USER=
ND_PASS=

# ============================================================================
# 7. Whole-album downloads through a VPN  (only with docker-compose.vpn.yml)
# ============================================================================
# Values come from your VPN provider; see https://github.com/qdm12/gluetun-wiki and docs/downloads-stack.md.
VPN_PROVIDER=
WG_PRIVATE_KEY=
WG_ADDRESSES=
VPN_COUNTRY=

# ============================================================================
# 8. Advanced: running the `eco` binary outside Docker
# ============================================================================
# The defaults are right for `make run`; set these only if your setup differs.
# ECO_NAVIDROME_URL=http://127.0.0.1:4533   # where Eco reaches Navidrome
# ECO_LISTEN=127.0.0.1:8000                 # address Eco listens on
# YTDLP_BIN=/path/to/yt-dlp                 # default: yt-dlp on PATH, else ./bin/yt-dlp
# FFMPEG_BIN=/path/to/ffmpeg                # default: ffmpeg on PATH
# ECO_ROOT=/path/to/folder                  # where .env and .spotify_token.json are read/written
